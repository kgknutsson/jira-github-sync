{
  "name": "@kgk/jira-github-sync",
  "version": "1.0.2",
  "private": true,
  "description": "GitHub Action that moves Jira issues and posts comments from GitHub events, driven by a YAML rules file",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kgknutsson/jira-github-sync.git"
  },
  "bin": {
    "jira-github-sync": "dist/index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "validate": "node dist/index.mjs validate templates/jira-sync.config.yml --workflow templates/jira-sync.workflow.yml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "node build.mjs && tsc --noEmit && vitest run && npm run validate"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
