{
  "name": "@kgk/jira-github-sync",
  "version": "1.0.0",
  "description": "Portable GitHub Actions runner for Jira issue status sync (bundled ESM, copy into any repo)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kgknutsson/jira-github-sync.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "verify": "node dist/verify.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "node build.mjs && tsc --noEmit && vitest run && node dist/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
