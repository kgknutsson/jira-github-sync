                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "headRef": {
          "description": "Source branch (push: the pushed branch), without refs/heads/.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "label": {
          "description": "The pull request has at least one of these labels.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "notLabel": {
          "description": "The pull request has none of these labels (e.g. an opt-out label).",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
